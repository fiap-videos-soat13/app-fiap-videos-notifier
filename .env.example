PORT=3002
# Service-owned Postgres (docker compose up postgres -d) — port 5436
DATABASE_URL=postgresql://fiap:fiap@localhost:5436/fiap_videos_notifier
# Shared infra Postgres (app-fiap-videos-infra/docker) — port 5433
# DATABASE_URL=postgresql://fiap:fiap@localhost:5433/fiap_videos_notifier
RABBITMQ_URL=amqp://fiap:fiap@localhost:5673/
VIDEO_EVENTS_EXCHANGE=fiap-videos.events
VIDEO_EVENTS_DLX=fiap-videos.events.dlx
RABBITMQ_CONNECTION_NAME=notifier

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@fiap-videos.local

# Base URL for job status links in e-mails (e.g. portal or API)
APP_STATUS_URL=http://localhost:3000
